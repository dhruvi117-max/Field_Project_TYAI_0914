# Copy this file to .env. Never commit the real .env file.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=retail_shelf_intelligence
MODEL_WEIGHTS_PATH=../models/shelf_yolo.pt
UPLOAD_DIR=../data/uploads
AUDIT_ARTIFACT_DIR=../data/audit_artifacts
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=8000
MIN_DETECTION_CONFIDENCE=0.35
RESTOCK_COOLDOWN_MINUTES=60
MAX_AUDITS_PER_MINUTE=12
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional shared key for a classroom deployment. Leave blank for local development.
API_KEY=
# Optional. Local SQLite tracker example; no account or server required.
MLFLOW_TRACKING_URI=sqlite:///C:/Users/your-name/Desktop/ffpp/mlruns/mlflow.db
